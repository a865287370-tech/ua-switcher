{
  "manifest_version": 3,
  "name": "UA Switcher — Client Hints Aware",
  "short_name": "UA Switcher",
  "version": "1.0.0",
  "description": "Spoof User-Agent with full Client Hints consistency — what you switch is what every detector sees, in headers and JavaScript.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "scripting",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/main.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "UA Switcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
